{
  "name": "myfav-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run -w server dev\" \"npm run -w client dev\"",
    "build": "npm-run-all build:server build:client",
    "check": "npm-run-all check:server build:client",
    "build:server": "npm run -w server build",
    "build:client": "npm run -w client build",
    "check:server": "npm run -w server check"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "npm-run-all": "^4.1.5"
  }
}
